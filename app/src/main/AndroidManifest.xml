<?xml version="1.0" encoding="utf-8"?>
<!--
  Note that parasitically NONE of this is installed: the manager is injected into the
  host process, so no component declared here exists at runtime and no permission
  listed here is granted — the host's are what apply. This manifest governs the
  standalone install used for development, and the LAUNCH_MANAGER category below is
  what ParasiticManagerSystemHooker matches on to redirect the activity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The module store and the GitHub activity feed on Home. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required from API 33 for the framework's status notification toggle to do anything. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 运行期持有 partial wakelock：显示照样关掉（压内核竞态），但不让系统进 Doze ——
         否则 adb 拉起的 Shizuku 这类后台进程会在跑的过程中被系统回收（用户实测反馈）。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Installing a module downloaded from the store. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The module and scope lists have to see every installed package, not just launchable ones. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 无线调试「通知配对」：配对码经通知 RemoteInput 回调时，App 必然在后台，
         必须走前台服务通道才能让 Service 活到 SPAKE2 握手完成。
         Android 12+ 缺这两个权限时 startForeground 会被 enforcePermission 直接拒绝
         （日志表现为 RemoteException + 进程被杀 + 配对「没下文」）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vector">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vector">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="cn.nanoturtle.rootmys9280.manager.LAUNCH_MANAGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Lets the system Settings app surface Vector under an app's preferences entry. -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 系统版本选择页：RootFlow 版本卡片跳转，独立全屏选择载荷。 -->
        <activity
            android:name=".ui.firmware.FirmwareSelectActivity"
            android:exported="false"
            android:theme="@style/Theme.Vector" />

        <!--
          无线调试通知配对：通知上 RemoteInput 的 PendingIntent 指向此 Service，
          在后台接收配对码并执行配对，不打断系统设置里的配对码页面
          （Activity 接收会把用户带回 App，导致配对码页面关闭、服务停止）。
        -->
        <service
            android:name=".rootmy.PairingReplyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ 要求 specialUse 前台服务说明具体用途（供应用市场审核，
                 本地自签安装不影响）。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="adb_wireless_pairing" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
